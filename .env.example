# Copy to .env for local cloud-mode development. Do not commit real secrets.
ORS_ENV=development
ORS_SESSION_SECRET=replace-this-with-a-long-random-secret
ORS_COOKIE_SECURE=false
DATABASE_URL=postgresql+psycopg://ors:ors@localhost:5432/ors
REDIS_URL=redis://localhost:6379/0
ORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
