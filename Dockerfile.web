FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/backend ORS_APP_ROOT=/app
WORKDIR /app
COPY requirements-web.txt requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir -r requirements-web.txt
COPY backend ./backend
COPY frontend ./frontend
EXPOSE 8000
CMD ["sh", "-c", "uvicorn orstudio.web_api:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips=*"]
